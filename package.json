{
  "name": "infosys",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo do InfoSys — Gestão operacional para prestadores de serviço técnico.",
  "author": "Gustavo Amancio <gustavoamanciocom@gmail.com>",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "install:all": "bun install --cwd apps/api",
    "dev": "bun run --cwd apps/api dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run --cwd apps/api build",
    "lint": "bun run --cwd apps/api lint",
    "lint:fix": "bun run --cwd apps/api lint:fix",
    "format": "bun run --cwd apps/api format",
    "format:check": "bun run --cwd apps/api format:check",
    "typecheck": "bun run --cwd apps/api typecheck",
    "test": "bun run --cwd apps/api test",
    "test:cov": "bun run --cwd apps/api test:cov",
    "test:e2e": "bun run --cwd apps/api test:e2e"
  }
}
