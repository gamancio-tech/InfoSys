#!/usr/bin/env sh
set -e

# 1. Bloqueio nativo contra arquivos de ambiente/chaves adicionados com git add -f
FORBIDDEN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env($|\.(?!example$))|\.(pem|key)$' || true)
if [ -n "$FORBIDDEN_FILES" ]; then
  echo "❌ [pre-commit] Tentativa de commit de arquivo sensível bloqueada:"
  echo "$FORBIDDEN_FILES"
  echo "Remova do stage com: git reset HEAD <arquivo>"
  exit 1
fi

# 2. Localiza o binário do gitleaks (PATH ou diretório padrão do WinGet no Windows)
GITLEAKS_BIN=""
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS_BIN="gitleaks"
elif [ -n "$LOCALAPPDATA" ] && [ -x "$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe" ]; then
  GITLEAKS_BIN="$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe"
elif [ -n "$LOCALAPPDATA" ]; then
  WINGET_GITLEAKS=$(find "$LOCALAPPDATA/Microsoft/WinGet/Packages" -maxdepth 2 -name "gitleaks.exe" 2>/dev/null | head -n 1 || true)
  if [ -n "$WINGET_GITLEAKS" ]; then
    GITLEAKS_BIN="$WINGET_GITLEAKS"
  fi
fi

if [ -z "$GITLEAKS_BIN" ]; then
  echo "⚠️  [pre-commit] 'gitleaks' não encontrado na máquina local."
  echo "   Para ativar a varredura local de segredos, instale com:"
  echo "     winget install Gitleaks.Gitleaks"
  if [ "${STRICT_GITLEAKS:-0}" = "1" ]; then
    exit 1
  fi
  exit 0
fi

echo "🔒 [pre-commit] Verificando segredos no stage com Gitleaks..."
"$GITLEAKS_BIN" protect --staged --redact --verbose

