{
  "name": "@infosys/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Frontend Web e PWA do InfoSys — Interface mobile-first em React + TypeScript + Vite para gestão operacional de prestadores de serviço técnico.",
  "author": "Gustavo Amancio <gustavoamanciocom@gmail.com>",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware src/ vite.config.ts",
    "lint:fix": "oxlint --type-aware --fix src/ vite.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "api:generate": "openapi-typescript http://localhost:3000/api/openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@infosys/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
