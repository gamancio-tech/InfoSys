# ─── Aplicação / Runtime (ADR-0002) ──────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ─── Banco de Dados · PostgreSQL / Supabase (ADR-0004, ADR-0008, ADR-0010) ───
# DATABASE_URL: conexão via pooler (modo transação em produção) usada pela API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infosys?schema=public"
# DIRECT_URL: conexão direta obrigatória para migrations do Prisma e fila pg-boss
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/infosys?schema=public"

# ─── Autenticação & CORS · Better Auth (ADR-0004, ADR-0005) ──────────────────
# Segredo com no mínimo 32 caracteres (ex.: openssl rand -base64 32)
BETTER_AUTH_SECRET="change-me-generate-at-least-32-chars-secret-key"
BETTER_AUTH_URL="http://localhost:3000"
WEB_ORIGIN="http://localhost:5173"

# Login Social Google (RF-AUT-002 — opcional em dev local)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Arquivos · Supabase Storage (ADR-0006, docs/07-seguranca.md) ────────────
# Atenção: SUPABASE_SERVICE_ROLE_KEY é exclusiva do backend; nunca expor no front
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── E-mail Transacional · Resend (docs/03-arquitetura.md) ───────────────────
RESEND_API_KEY=""
MAIL_FROM="InfoSys <noreply@seudominio.com>"

# ─── Observabilidade · Sentry (RNF-009, docs/09-operacao.md) ─────────────────
SENTRY_DSN=""

